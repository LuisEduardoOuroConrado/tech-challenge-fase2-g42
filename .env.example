# Copie para .env e preencha. O arquivo .env NUNCA deve ser commitado (já está no .gitignore).
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux/macOS:           cp .env.example .env

# ---------------------------------------------------------------------------
# Provedor de LLM
#   mock   -> sem rede, respostas fixas (padrão para testes e CI)
#   groq   -> gratuito, cada integrante cria a própria conta em https://console.groq.com/keys
#   openai -> pago (crédito pré-pago), usado para relatório final e vídeo
# ---------------------------------------------------------------------------
LLM_PROVIDER=mock

# Groq (compatível com o SDK openai)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Parâmetros comuns
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1500
LLM_CACHE_DIR=data/cache/llm        # respostas cacheadas (não versionadas)

# ---------------------------------------------------------------------------
# Roteamento (P2 opcional) — servidor OSRM para distâncias/traçados reais
# ---------------------------------------------------------------------------
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_CACHE_DIR=data/cache/osrm

# ---------------------------------------------------------------------------
# Execução
# ---------------------------------------------------------------------------
MEDROUTE_SEED=17
MEDROUTE_LOG_LEVEL=INFO
